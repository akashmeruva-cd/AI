# ==============================================================================
# AI Agents Lab Environment Configuration
# ==============================================================================
# You only need ONE provider API key to run all labs.
# Choose your preferred provider below:

# Option 1: Google Gemini (Recommended - Free Tier available)
# Get key: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI (GPT-4o, GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Option 3: Groq (Ultra-fast inference with Llama 3.3 / Mixtral)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default LLM Model Name
# Default for Gemini: gemini-3.8-flash or gemini-3.7-flash
# Default for OpenAI: gpt-4o-mini or gpt-4o
# Default for Groq: llama-3.3-70b-versatile
AI_MODEL_NAME=gemini-3.8-flash
